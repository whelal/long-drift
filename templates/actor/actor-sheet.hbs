<form class="{{cssClass}} flexcol red-shell" autocomplete="off">
  <aside class="red-sidebar">
    <div class="red-portrait-wrap">
      <img class="profile red-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="{{actor.name}}" />
    </div>

    <div class="red-name-card">
      <input class="red-name-input" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'MF.Name'}}"/>
      <input class="red-role-input" name="system.role.name" type="text" value="{{system.role.name}}" placeholder="Role"/>
    </div>

    <div class="red-vitals-grid">
      <div class="red-vital">
        <span class="label">Hit Points</span>
        <span class="value">{{system.substats.hp_current}} / {{system.substats.hp}}</span>
      </div>
      <div class="red-vital">
        <span class="label">Humanity</span>
        <span class="value">{{system.substats.humanity}}</span>
      </div>
      <div class="red-vital">
        <span class="label">Death Save</span>
        <span class="value">{{system.substats.death}}</span>
      </div>
      <div class="red-vital">
        <span class="label">I.P.</span>
        <span class="value">{{system.meta.points}}</span>
      </div>
      <div class="red-vital red-vital-wide">
        <span class="label">Role Ability Rank</span>
        <span class="value">{{system.role.rank}}</span>
      </div>
    </div>

    <div class="red-stats-rail">
      <div class="red-stat"><span>INT</span><strong>{{system.stats.INT.value}}</strong></div>
      <div class="red-stat"><span>REF</span><strong>{{system.stats.REF.value}}</strong></div>
      <div class="red-stat"><span>DEX</span><strong>{{system.stats.DEX.value}}</strong></div>
      <div class="red-stat"><span>TECH</span><strong>{{system.stats.TECH.value}}</strong></div>
      <div class="red-stat"><span>COOL</span><strong>{{system.stats.COOL.value}}</strong></div>
      <div class="red-stat"><span>WILL</span><strong>{{system.stats.WILL.value}}</strong></div>
      <div class="red-stat"><span>LUCK</span><strong>{{system.stats.LUCK.value}}</strong></div>
      <div class="red-stat"><span>MOVE</span><strong>{{system.stats.MOVE.value}}</strong></div>
      <div class="red-stat"><span>BODY</span><strong>{{system.stats.BODY.value}}</strong></div>
      <div class="red-stat"><span>EMP</span><strong>{{system.stats.EMP.value}}</strong></div>
    </div>

    <div class="red-sidebar-actions">
      <button type="button" class="link-token-button" title="Link this Actor to the selected Token">Link Token</button>
      <button type="button" class="unlink-token-button" title="Unlink this Actor from the selected Token">Unlink Token</button>
    </div>
  </aside>

  <section class="red-main">
    <nav class="sheet-tabs tabs red-tabs">
      <a class="item" data-tab="stats">{{localize 'MF.TabStats'}}</a>
      <a class="item" data-tab="combat">{{localize 'MF.TabCombat'}}</a>
      <a class="item" data-tab="skills">{{localize 'MF.TabSkills'}}</a>
      <a class="item" data-tab="body">{{localize 'MF.TabMekton'}}</a>
      <a class="item" data-tab="equipment">{{localize 'MF.TabEquipment' 'Equipment'}}</a>
      <a class="item" data-tab="notes">{{localize 'MF.TabNotes' 'Notes'}}</a>
    </nav>

    <section class="sheet-body red-body">
    {{{_tabStatsHtml}}}

    {{{_tabCombatHtml}}}

    {{{_tabSkillsHtml}}}

    {{{_tabBodyHtml}}}

    {{{_tabEquipmentHtml}}}

    {{{_tabNotesHtml}}}
    </section>
  </section>
</form>
