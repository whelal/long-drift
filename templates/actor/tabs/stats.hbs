{{!-- Stats tab partial --}}
<div class="tab stats" data-tab="stats">
  <div class="stats-container">
    <!-- Stats grid: Row 1 (5 stats), Row 2 (5 stats) -->
    <div class="stats-grid-top">
      <div class="stat-row-top row-five">
        {{!-- Row 1: INT REF DEX TECH COOL --}}
        <div class="stat-box" data-stat="INT">
          <div class="stat-header">INT</div>
          <div class="stat-inline">
            <input name="system.stats.INT.value" type="number" value="{{system.stats.INT.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="INT" title="Roll INT" aria-label="Roll INT"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
        <div class="stat-box" data-stat="REF">
          <div class="stat-header">REF</div>
          <div class="stat-inline">
            <input name="system.stats.REF.value" type="number" value="{{system.stats.REF.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="REF" title="Roll REF" aria-label="Roll REF"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
        <div class="stat-box" data-stat="DEX">
          <div class="stat-header">DEX</div>
          <div class="stat-inline">
            <input name="system.stats.DEX.value" type="number" value="{{system.stats.DEX.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="DEX" title="Roll DEX" aria-label="Roll DEX"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
        <div class="stat-box" data-stat="TECH">
          <div class="stat-header">TECH</div>
          <div class="stat-inline">
            <input name="system.stats.TECH.value" type="number" value="{{system.stats.TECH.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="TECH" title="Roll TECH" aria-label="Roll TECH"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
        <div class="stat-box" data-stat="COOL">
          <div class="stat-header">COOL</div>
          <div class="stat-inline">
            <input name="system.stats.COOL.value" type="number" value="{{system.stats.COOL.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="COOL" title="Roll COOL" aria-label="Roll COOL"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
      </div>
      <div class="stat-row-top row-five">
        {{!-- Row 2: WILL LUCK MOVE BODY EMP --}}
        <div class="stat-box" data-stat="WILL">
          <div class="stat-header">WILL</div>
          <div class="stat-inline">
            <input name="system.stats.WILL.value" type="number" value="{{system.stats.WILL.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="WILL" title="Roll WILL" aria-label="Roll WILL"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
        <div class="stat-box" data-stat="LUCK">
          <div class="stat-header">LUCK</div>
          <div class="stat-inline">
            <input name="system.stats.LUCK.value" type="number" value="{{system.stats.LUCK.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="LUCK" title="Roll LUCK" aria-label="Roll LUCK"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
        <div class="stat-box" data-stat="MOVE">
          <div class="stat-header">MOVE</div>
          <div class="stat-inline">
            <input name="system.stats.MOVE.value" type="number" value="{{system.stats.MOVE.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="MOVE" title="Roll MOVE" aria-label="Roll MOVE"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
        <div class="stat-box" data-stat="BODY">
          <div class="stat-header">BODY</div>
          <div class="stat-inline">
            <input name="system.stats.BODY.value" type="number" value="{{system.stats.BODY.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="BODY" title="Roll BODY" aria-label="Roll BODY"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
        <div class="stat-box" data-stat="EMP">
          <div class="stat-header">EMP</div>
          <div class="stat-inline">
            <input name="system.stats.EMP.value" type="number" value="{{system.stats.EMP.value}}" class="stat-input"/>
            <button type="button" class="stat-roll" data-ability="EMP" title="Roll EMP" aria-label="Roll EMP"><i class="fas fa-dice-d20"></i></button>
          </div>
        </div>
      </div>
    </div>

    <!-- Two-column body/ref panels -->
    <div class="stats-two-col">
      <div class="panel panel-left">
        <h4>BODY</h4>
        <div class="panel-list">
          <label>• Stun Save: <input class="substat-input" name="system.substats.stun" type="number" min="0" value="{{system.substats.stun}}"/><button type="button" class="stun-save-roll" title="Roll 1d10 Stun Save" aria-label="Roll 1d10 Stun Save"><i class="fas fa-dice-d10"></i></button></label>
          <label>• Death Save: <input class="substat-input" name="system.substats.death" type="number" min="0" value="{{system.substats.death}}"/></label>
          <label>• Body Type Mod: <input class="substat-input" name="system.substats.bodyTypeMod" type="number" value="{{system.substats.bodyTypeMod}}"/></label>
          <label>• Lift: <input class="substat-input" name="system.substats.lift" type="number" min="0" value="{{system.substats.lift}}"/></label>
          <label>• Carry: <input class="substat-input" name="system.substats.carry" type="number" min="0" value="{{system.substats.carry}}"/></label>
        </div>
        <div class="panel-emp">
          <h5>EMP</h5>
          <label>• Humanity: <input class="substat-input" name="system.substats.humanity" type="number" min="0" value="{{system.substats.humanity}}"/></label>
        </div>
      </div>

      <div class="panel panel-right">
        <h4>MOVE</h4>
        <div class="panel-list">
          <label>• Run: <input class="substat-input" name="system.substats.run" type="number" min="0" step="0.01" value="{{system.substats.run}}"/></label>
          <label>• Leap: <input class="substat-input" name="system.substats.leap" type="number" min="0" step="0.01" value="{{system.substats.leap}}"/></label>
          <label>• Swim: <input class="substat-input" name="system.substats.swim" type="number" min="0" step="0.01" value="{{system.substats.swim}}"/></label>
        </div>
        <div class="panel-initiative">
          <h5>REF</h5>
          <label>• {{localize 'MF.InitiativeMod'}}: <input class="substat-input" name="system.substats.initiative" type="number" value="{{system.substats.initiative}}" title="{{localize 'MF.InitiativeModTooltip'}}" step="1"/></label>
        </div>
      </div>
    </div>

    <div class="stats-two-col">
      <div class="panel panel-left">
        <h4>ROLE ABILITY</h4>
        <div class="panel-list">
          <label>• Role: <input class="substat-input" type="text" value="{{system.role.name}}" placeholder="Solo, Netrunner, Tech..." disabled title="Edit role name in the sidebar field"/></label>
          <label>• Ability: <input class="substat-input" name="system.role.ability" type="text" value="{{system.role.ability}}" placeholder="Combat Awareness..."/></label>
          <label>• Rank: <input class="substat-input" name="system.role.rank" type="number" min="0" max="10" step="1" value="{{system.role.rank}}"/></label>
          <label>• Notes: <input class="substat-input" name="system.role.notes" type="text" value="{{system.role.notes}}" placeholder="Current role ability focus"/></label>
        </div>
      </div>

      <div class="panel panel-right">
        <h4>CRITICAL INJURIES</h4>
        <div class="panel-list">
          <button type="button" class="crit-injury-add"><i class="fas fa-plus"></i> Add Critical Injury</button>
          {{#if criticalInjuries.length}}
            {{#each criticalInjuries as |inj|}}
              <div class="crit-injury-row" data-injury-index="{{inj.index}}" style="display:grid;grid-template-columns:1.3fr auto 1fr auto;gap:0.35rem;align-items:center;">
                <input type="text" class="crit-injury-name" value="{{inj.name}}" placeholder="Injury name"/>
                <label style="display:flex;align-items:center;gap:0.2rem;white-space:nowrap;">Healed <input type="checkbox" class="crit-injury-healed" {{#if inj.healed}}checked{{/if}}/></label>
                <input type="text" class="crit-injury-notes" value="{{inj.notes}}" placeholder="Notes"/>
                <button type="button" class="crit-injury-delete" title="Delete Injury"><i class="fas fa-trash"></i></button>
              </div>
            {{/each}}
          {{else}}
            <p class="mf-empty">No critical injuries tracked.</p>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>
