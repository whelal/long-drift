{{!-- Vehicle tab partial --}}
<div class="tab vehicle" data-tab="vehicle">
  <style>
    .tab.vehicle .vehicle-section { margin-bottom: 10px; }
    .tab.vehicle .vehicle-section-header { background: #000; color: #fff; padding: 4px 8px; font-weight: 700; font-size: 0.85rem; margin-bottom: 0; text-transform: uppercase; }
    .tab.vehicle .vehicle-control-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid #bbb; border-top: none; }
    .tab.vehicle .vehicle-control-row { display: flex; align-items: center; padding: 4px 8px; border-bottom: 1px solid #ddd; border-right: 1px solid #ddd; gap: 6px; }
    .tab.vehicle .vehicle-control-row:nth-child(even) { border-right: none; }
    .tab.vehicle .vehicle-control-row:nth-last-child(-n+2) { border-bottom: none; }
    .tab.vehicle .skill-label { flex: 1; font-weight: 500; font-size: 0.8rem; }
    .tab.vehicle .skill-total-display { min-width: 55px; text-align: center; font-size: 0.75rem; color: #333; font-weight: 500; }
    .tab.vehicle .skill-roll-cell { width: 28px; text-align: center; }
    .tab.vehicle .skill-roll-cell button { padding: 1px 4px; font-size: 0.8rem; }
    .tab.vehicle .vehicle-list { border: 1px solid #bbb; border-top: none; background: #f7f7f7; padding: 6px; display: grid; gap: 6px; }
    .tab.vehicle .vehicle-row { display: grid; grid-template-columns: minmax(0, 18ch) minmax(0, 1fr) auto; gap: 8px; align-items: center; border: 1px solid #d6d6d6; background: #fff; padding: 6px; }
    .tab.vehicle .vehicle-add-wrap { padding: 4px 8px; border: 1px solid #bbb; border-top: none; text-align: center; background: #f5f5f5; }
    .tab.vehicle .vehicle-mech-note { border: 1px solid #bbb; border-top: none; background: #f7f7f7; padding: 8px; font-size: 0.8rem; color: #444; }
  </style>

  <div class="vehicle-container">
    <div class="vehicle-section">
      <div class="vehicle-section-header">CONTROL SKILLS</div>
      <div class="vehicle-control-list">
        {{#if vehicleControlSkills.length}}
          {{#each vehicleControlSkills as |sk|}}
            <div class="vehicle-control-row" data-skill-id="{{sk.id}}">
              <span class="skill-label">{{sk.name}}</span>
              <span class="skill-total-display">+ {{sk.total}}</span>
              <div class="skill-roll-cell">
                <button type="button" class="skill-roll" title="Roll {{sk.name}}"><i class="fas fa-dice-d20"></i></button>
              </div>
            </div>
          {{/each}}
        {{else}}
          <p class="mf-empty" style="margin: 6px 8px;">No control skills found.</p>
        {{/if}}
      </div>
    </div>

    <div class="vehicle-section">
      <div class="vehicle-section-header">VEHICLES</div>
      <div class="vehicle-list">
        {{#if vehicles.length}}
          {{#each vehicles as |vehicle|}}
            <div class="vehicle-row" data-vehicle-index="{{vehicle.index}}">
              <input type="text" class="vehicle-name" value="{{vehicle.name}}" placeholder="Vehicle name" />
              <input type="text" class="vehicle-notes" value="{{vehicle.notes}}" placeholder="Notes" />
              <button type="button" class="vehicle-delete" title="Remove Vehicle"><i class="fas fa-trash"></i></button>
            </div>
          {{/each}}
        {{else}}
          <p class="mf-empty" style="margin: 0;">No vehicles recorded.</p>
        {{/if}}
      </div>
      <div class="vehicle-add-wrap">
        <button type="button" class="vehicle-add" style="font-size: 0.75rem; padding: 2px 8px;"><i class="fas fa-plus"></i> Add Vehicle</button>
      </div>
    </div>

    <div class="vehicle-section">
      <div class="vehicle-section-header">MECH</div>
      <div class="vehicle-mech-note">Mech combat managed via mech actor.</div>
    </div>
  </div>
</div>
