{{!-- Combat tab partial --}}
<div class="tab combat" data-tab="combat">
  <style>
    .tab.combat .combat-section { margin-bottom: 8px; }
    .tab.combat .combat-section-header { background: #000; color: #fff; padding: 4px 8px; font-weight: 700; font-size: 0.85rem; margin-bottom: 0; text-transform: uppercase; }
    .tab.combat .combat-skills-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid #bbb; border-top: none; }
    .tab.combat .combat-skill-row { display: flex; align-items: center; padding: 4px 8px; border-bottom: 1px solid #ddd; border-right: 1px solid #ddd; gap: 6px; }
    .tab.combat .combat-skill-row:nth-child(odd) { border-right: 1px solid #ddd; }
    .tab.combat .combat-skill-row:nth-child(even) { border-right: none; }
    .tab.combat .combat-skill-row:nth-last-child(-n+2) { border-bottom: none; }
    .tab.combat .skill-label { flex: 1; font-weight: 500; font-size: 0.8rem; }
    .tab.combat .skill-total-display { min-width: 55px; text-align: center; font-size: 0.75rem; color: #333; font-weight: 500; }
    .tab.combat .skill-roll-cell { width: 28px; text-align: center; }
    .tab.combat .skill-roll-cell button { padding: 1px 4px; font-size: 0.8rem; }
    .tab.combat .weapons-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; margin-top: 2px; }
    .tab.combat .weapons-table tbody tr { border-bottom: 1px solid #ddd; }
    .tab.combat .weapons-table td { padding: 3px 8px; vertical-align: middle; }
    .tab.combat .weapons-table td:last-child { width: 28px; text-align: center; }
    .tab.combat .weapon-type-cell { display: flex; align-items: center; gap: 4px; }
    .tab.combat .weapon-type-cell select { flex: 1; min-width: 0; }
    .tab.combat .weapon-range-info { width: 20px; height: 20px; padding: 0; font-size: 0.72rem; line-height: 1; }
    .tab.combat .weapon-cards { display: grid; gap: 6px; border: 1px solid #bbb; border-top: none; padding: 6px; background: #f7f7f7; }
    .tab.combat details.weapon-card { border: 1px solid #b8b8b8; background: #fff; border-radius: 4px; }
    .tab.combat details.weapon-card summary { list-style: none; cursor: pointer; padding: 4px 6px; }
    .tab.combat details.weapon-card summary::-webkit-details-marker { display: none; }
    .tab.combat .weapon-summary-line { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .tab.combat .weapon-expand-icon { font-size: 0.75rem; color: #444; width: 12px; text-align: center; flex-shrink: 0; }
    .tab.combat details.weapon-card[open] .weapon-expand-icon { transform: rotate(90deg); display: inline-block; }
    .tab.combat .weapon-name-input {
      flex: 0 0 20ch;
      width: 20ch;
      min-width: 12ch;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .tab.combat .weapon-type-select { width: 20ch; flex: 0 0 20ch; }
    .tab.combat .weapon-quality-select { width: 12ch; flex: 0 0 12ch; }
    .tab.combat .weapon-skill-select { width: 16ch; flex: 0 0 16ch; }
    .tab.combat .weapon-damage-input { width: 74px; flex: 0 0 74px; }
    .tab.combat .weapon-scale-pill { font-size: 0.62rem; font-weight: 700; border: 1px solid #555; border-radius: 10px; padding: 1px 6px; white-space: nowrap; }
    .tab.combat .weapon-scale-pill.mech { background: #222; color: #fff; border-color: #111; }
    .tab.combat .weapon-scale-pill.personal { background: #ececec; color: #333; }
    .tab.combat .weapon-attack-modes { display: flex; gap: 4px; margin-left: auto; }
    .tab.combat .weapon-summary-line .weapon-field,
    .tab.combat .weapon-mode-btn,
    .tab.combat .weapon-icon-btn {
      height: 26px;
      font-size: 0.72rem;
      padding: 0 6px;
      line-height: 1;
    }
    .tab.combat .weapon-mode-btn { min-width: 30px; }
    .tab.combat .weapon-icon-btn { width: 24px; padding: 0; display: inline-flex; align-items: center; justify-content: center; }
    .tab.combat .weapon-card-body { border-top: 1px solid #ddd; padding: 6px; display: grid; gap: 8px; }
    .tab.combat .weapon-detail-grid { display: grid; grid-template-columns: 64px 64px 70px 106px 160px 1fr 90px; gap: 6px; align-items: end; }
    .tab.combat .weapon-detail { display: grid; gap: 2px; }
    .tab.combat .weapon-detail label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; color: #555; }
    .tab.combat .weapon-dv-panel { border-top: 1px dashed #c9c9c9; padding-top: 4px; }
    .tab.combat .weapon-dv-grid { display: flex; flex-wrap: wrap; gap: 12px; font-size: 0.66rem; color: #666; }
    .tab.combat .weapon-autofire-inline { color: #666; font-weight: 600; }
    .tab.combat .crit-injury-list { border: 1px solid #bbb; border-top: none; background: #f7f7f7; padding: 6px; display: grid; gap: 6px; }
    .tab.combat .crit-injury-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 8px; align-items: center; border: 1px solid #d6d6d6; background: #fff; padding: 6px; }
    .tab.combat .crit-injury-healed-wrap { display: inline-flex; align-items: center; gap: 4px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: #555; }
    .tab.combat .crit-injury-add-wrap { padding: 4px 8px; border: 1px solid #bbb; border-top: none; text-align: center; background: #f5f5f5; }
  </style>

  <div class="combat-container">
    <div class="combat-section human-combat">
      <div class="combat-section-header">HUMAN COMBAT SKILLS</div>
      {{#if hasSkillItems}}
        <div class="combat-skills-list">
          {{#each skillGroups as |group|}}
            {{#if (eq group.category 'Ranged Weapon')}}
              {{#each group.skills as |sk|}}
                <div class="combat-skill-row" data-skill-id="{{sk.id}}">
                  <span class="skill-label">{{sk.name}} {{#if (and sk.hard (not sk.hasHardMarker))}}<span class="hard-flag" title="Hard Skill">(H)</span>{{/if}}</span>
                  <span class="skill-total-display">+ {{sk.total}}</span>
                  <div class="skill-roll-cell">
                    <button type="button" class="skill-roll" title="Roll {{sk.name}}"><i class="fas fa-dice-d20"></i></button>
                  </div>
                </div>
              {{/each}}
            {{/if}}
            {{#if (eq group.category 'Fighting')}}
              {{#each group.skills as |sk|}}
                <div class="combat-skill-row" data-skill-id="{{sk.id}}">
                  <span class="skill-label">{{sk.name}} {{#if (and sk.hard (not sk.hasHardMarker))}}<span class="hard-flag" title="Hard Skill">(H)</span>{{/if}}</span>
                  <span class="skill-total-display">+ {{sk.total}}</span>
                  <div class="skill-roll-cell">
                    <button type="button" class="skill-roll" title="Roll {{sk.name}}"><i class="fas fa-dice-d20"></i></button>
                  </div>
                </div>
              {{/each}}
            {{/if}}
          {{/each}}
        </div>
      {{else}}
        <div class="combat-skills-list" style="padding: 6px 12px;">
          <p class="mf-empty" style="margin: 0;">No combat skills yet.</p>
        </div>
      {{/if}}

      <div class="combat-section-header" style="margin-top: 12px;">WEAPONS</div>
      <div class="weapon-cards">
        {{#each combatWeapons as |item|}}
          <details class="weapon-card" data-item-id="{{item.id}}">
            <summary>
              <div class="weapon-summary-line">
                <span class="weapon-expand-icon"><i class="fas fa-chevron-right"></i></span>
                <input type="text" class="weapon-field weapon-name-input" value="{{item.name}}" data-field="name" />
                <span class="weapon-scale-pill {{#if item.system.isMecha}}mech{{else}}personal{{/if}}">{{item.displayScale}}</span>
                <select name="system.weapons.{{@index}}.weaponType" class="weapon-field weapon-type-select" data-field="weaponType">
                  {{#each @root.weaponTypeOptions as |weaponType|}}
                    <option value="{{weaponType}}" {{#if (eq weaponType ../system.weaponType)}}selected{{/if}}>{{weaponType}}</option>
                  {{/each}}
                </select>
                <input type="text" name="system.weapons.{{@index}}.damage" class="weapon-field weapon-damage-input" value="{{item.system.damage}}" data-field="damage" placeholder="2d6" />
                <div class="weapon-attack-modes">
                  {{#each item.attackModes as |mode|}}
                    <button type="button" class="weapon-roll weapon-mode-btn" title="{{mode.title}}" data-item-id="{{../id}}" data-mode="{{mode.key}}">{{mode.label}}</button>
                  {{/each}}
                  <button type="button" class="weapon-damage-roll weapon-icon-btn" title="Roll damage: {{item.system.damage}}" data-item-id="{{item.id}}"><i class="fas fa-dice"></i></button>
                  <button type="button" class="item-delete weapon-icon-btn" title="Delete Weapon" data-item-id="{{item.id}}"><i class="fas fa-trash"></i></button>
                </div>
              </div>
            </summary>

            <div class="weapon-card-body">
              <div class="weapon-detail-grid">
                <div class="weapon-detail">
                  <label>WA</label>
                  <input type="number" name="system.weapons.{{@index}}.wa" class="weapon-field" value="{{item.system.wa}}" data-field="wa" />
                </div>
                <div class="weapon-detail">
                  <label>ROF</label>
                  <input type="number" name="system.weapons.{{@index}}.rof" class="weapon-field" value="{{item.system.rof}}" min="1" data-field="rof" />
                </div>
                <div class="weapon-detail">
                  <label>Shots</label>
                  <input type="number" name="system.weapons.{{@index}}.shots" class="weapon-field" value="{{item.system.shots}}" data-field="shots" />
                </div>
                <div class="weapon-detail">
                  <label>Quality</label>
                  <select name="system.weapons.{{@index}}.quality" class="weapon-field weapon-quality-select" data-field="quality">
                    {{#each @root.weaponQualityOptions as |qualityOpt|}}
                      <option value="{{qualityOpt}}" {{#if (eq qualityOpt ../system.quality)}}selected{{/if}}>{{qualityOpt}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="weapon-detail">
                  <label>Skill</label>
                  <select name="system.weapons.{{@index}}.skill" class="weapon-field weapon-skill-select" data-field="skill">
                    <option value="" {{#unless item.system.skill}}selected{{/unless}}>—</option>
                    {{#each @root.weaponSkillOptions as |skillName|}}
                      <option value="{{skillName}}" {{#if (eq skillName ../system.skill)}}selected{{/if}}>{{skillName}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="weapon-detail">
                  <label>Note</label>
                  <input type="text" name="system.weapons.{{@index}}.note" class="weapon-field" value="{{item.system.note}}" data-field="note" placeholder="…" />
                </div>
                <div class="weapon-detail">
                  <label>Mech</label>
                  <label style="display:flex; align-items:center; gap:4px; font-size:0.72rem; text-transform:none; font-weight:600; color:#222;">
                    <input type="checkbox" class="weapon-field" data-field="isMecha" {{#if item.system.isMecha}}checked{{/if}} />
                    Scale
                  </label>
                </div>
              </div>

              <div class="weapon-dv-panel">
                <div class="weapon-dv-grid" aria-label="Range band DVs">
                  {{#each item.rangeBands as |band|}}
                    <span>{{band.label}}: DV {{band.dv}}</span>
                  {{/each}}
                  {{#if item.hasAutofire}}
                    <span class="weapon-autofire-inline">AF mode: {{item.autofireSummary}}</span>
                  {{/if}}
                </div>
              </div>
            </div>
          </details>
        {{/each}}
      </div>
      <div style="padding: 4px 8px; border: 1px solid #bbb; border-top: none; text-align: center; background: #f5f5f5;">
        <button type="button" class="create-weapon-item" style="font-size: 0.75rem; padding: 2px 8px;"><i class="fas fa-plus"></i> Add Weapon</button>
      </div>

      <div class="combat-section-header" style="margin-top: 12px;">ARMOR</div>
      <div style="border: 1px solid #bbb; border-top: none; background: #f7f7f7; padding: 6px; display: grid; gap: 6px;">
        <div style="display:grid; grid-template-columns: 1.2fr 1fr 0.8fr; gap: 8px; align-items:center; border: 1px solid #d6d6d6; background:#fff; padding: 6px;">
          <div><strong>Head</strong></div>
          <div style="display:flex; align-items:center; gap: 6px;">
            <label style="font-size:0.72rem; font-weight:700;">SP</label>
            <input type="number" name="system.armor.head.sp.value" min="0" step="1" value="{{system.armor.head.sp.value}}" style="width: 4.5rem; text-align:center;" />
            <span style="font-size:0.75rem;">/ {{system.armor.head.sp.max}}</span>
          </div>
          <div style="font-size:0.75rem;"><strong>Penalty:</strong> {{system.armor.head.penalty}}</div>
        </div>

        <div style="display:grid; grid-template-columns: 1.2fr 1fr 0.8fr; gap: 8px; align-items:center; border: 1px solid #d6d6d6; background:#fff; padding: 6px;">
          <div><strong>Body</strong></div>
          <div style="display:flex; align-items:center; gap: 6px;">
            <label style="font-size:0.72rem; font-weight:700;">SP</label>
            <input type="number" name="system.armor.body.sp.value" min="0" step="1" value="{{system.armor.body.sp.value}}" style="width: 4.5rem; text-align:center;" />
            <span style="font-size:0.75rem;">/ {{system.armor.body.sp.max}}</span>
          </div>
          <div style="font-size:0.75rem;"><strong>Penalty:</strong> {{system.armor.body.penalty}}</div>
        </div>
      </div>

      <div class="combat-section-header" style="margin-top: 12px;">CRITICAL INJURIES</div>
      <div class="crit-injury-list">
        {{#if criticalInjuries.length}}
          {{#each criticalInjuries as |injury|}}
            <div class="crit-injury-row" data-injury-index="{{injury.index}}">
              <input type="text" class="crit-injury-name" value="{{injury.name}}" placeholder="Injury name" />
              <label class="crit-injury-healed-wrap">
                <input type="checkbox" class="crit-injury-healed" {{#if injury.healed}}checked{{/if}} />
                Healed
              </label>
              <button type="button" class="crit-injury-delete" title="Delete Critical Injury"><i class="fas fa-trash"></i></button>
            </div>
          {{/each}}
        {{else}}
          <p class="mf-empty" style="margin: 0;">No critical injuries recorded.</p>
        {{/if}}
      </div>
      <div class="crit-injury-add-wrap">
        <button type="button" class="crit-injury-add" style="font-size: 0.75rem; padding: 2px 8px;"><i class="fas fa-plus"></i> Add Critical Injury</button>
      </div>
    </div>

  </div>
</div>
