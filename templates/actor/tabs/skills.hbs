{{!-- Skills tab partial --}}
<div class="tab skills" data-tab="skills">
  <div class="skill-controls flexrow">
        <button type="button" class="skill-filter-fav-toggle" data-active="{{_skillViewStateSkills.favOnly}}">
          {{#if _skillViewStateSkills.favOnly}}
            {{localize 'MF.ShowAllSkills'}}
          {{else}}
            {{localize 'MF.ShowFavOnly'}}
          {{/if}}
        </button>
        <button type="button" class="custom-skill-add custom-skill-add-top" title="{{localize 'MF.AddCustomSkill'}}">+</button>
    {{#unless hasSkillItems}}
      <div class="skill-menu" style="display:inline-block;position:relative;">
        <button type="button" class="skill-menu-kebab" title="More actions" aria-label="More actions" style="background:none;border:none;padding:0 6px;"><i class="fas fa-ellipsis-v"></i></button>
        <div class="skill-menu-dropdown" style="display:none;position:absolute;right:0;z-index:10;background:#222;padding:4px 0;border-radius:4px;box-shadow:0 2px 8px #0008;">
          <button type="button" class="seed-skills" title="Add Default Skills" aria-label="Seed Default Skills" style="width:100%;text-align:left;padding:4px 16px;background:none;border:none;color:#fff;">Seed Skills</button>
        </div>
      </div>
    {{/unless}}
  </div>
  {{#if hasSkillItems}}
    <div class="skills-two-col">
      <div class="skills-col">
        {{#each skillGroupsLeft as |group|}}
          <section class="skill-group-block" data-category="{{group.category}}">
            <header class="skill-group-head">
              <span class="group-spacer"></span>
              <span class="group-title">{{localize group.localizeKey fallback=group.category}}</span>
              <span class="group-col-label group-col-rank">LVL</span>
              <span class="group-col-label group-col-total">Base</span>
              <span class="group-spacer"></span>
            </header>
            <div class="group-body">
              {{#each group.skills as |sk|}}
                <div data-skill-id="{{sk.id}}" class="skill-item-row skill-row-compact" data-favorite="{{sk.favorite}}" data-category="{{group.category}}" role="row">
                  <a class="skill-fav" title="Toggle Favorite">{{#if sk.favorite}}★{{else}}☆{{/if}}</a>
                  <div class="skill-name-wrap">
                    <span class="skill-stat-chip">{{sk.stat}}</span>
                    <span class="skill-name">{{sk.name}}</span>
                  </div>
                  <input class="skill-rank" type="number" min="0" max="50" step="1" value="{{sk.rank}}"/>
                  <span class="skill-total">{{sk.total}}</span>
                  <button type="button" class="skill-roll" title="Roll {{sk.name}}"><i class="fas fa-dice-d20"></i></button>
                </div>
              {{/each}}
            </div>
          </section>
        {{/each}}
      </div>

      <div class="skills-col">
        {{#each skillGroupsRight as |group|}}
          <section class="skill-group-block" data-category="{{group.category}}">
            <header class="skill-group-head">
              <span class="group-spacer"></span>
              <span class="group-title">{{localize group.localizeKey fallback=group.category}}</span>
              <span class="group-col-label group-col-rank">LVL</span>
              <span class="group-col-label group-col-total">Base</span>
              <span class="group-spacer"></span>
            </header>
            <div class="group-body">
              {{#each group.skills as |sk|}}
                <div data-skill-id="{{sk.id}}" class="skill-item-row skill-row-compact" data-favorite="{{sk.favorite}}" data-category="{{group.category}}" role="row">
                  <a class="skill-fav" title="Toggle Favorite">{{#if sk.favorite}}★{{else}}☆{{/if}}</a>
                  <div class="skill-name-wrap">
                    <span class="skill-stat-chip">{{sk.stat}}</span>
                    <span class="skill-name">{{sk.name}}</span>
                  </div>
                  <input class="skill-rank" type="number" min="0" max="50" step="1" value="{{sk.rank}}"/>
                  <span class="skill-total">{{sk.total}}</span>
                  <button type="button" class="skill-roll" title="Roll {{sk.name}}"><i class="fas fa-dice-d20"></i></button>
                </div>
              {{/each}}
            </div>
          </section>
        {{/each}}

        <section class="skill-group-block" data-category="CUSTOM">
          <header class="skill-group-head">
            <span class="group-title">{{localize 'MF.CustomSkillsCategory'}}</span>
            <span class="group-cols"><button type="button" class="custom-skill-add" title="{{localize 'MF.AddCustomSkill'}}">+</button></span>
          </header>
          <div class="group-body">
            {{#each customSkills as |sk|}}
              <div data-skill-id="{{sk.id}}" class="skill-item-row skill-row-compact" data-favorite="{{sk.favorite}}" data-category="CUSTOM" role="row">
                <a class="skill-fav" title="Toggle Favorite">{{#if sk.favorite}}★{{else}}☆{{/if}}</a>
                <div class="skill-name-wrap">
                  <span class="skill-stat-chip">{{sk.stat}}</span>
                  <span class="skill-name">{{sk.name}}</span>
                </div>
                <input class="skill-rank" type="number" min="0" max="50" step="1" value="{{sk.rank}}"/>
                <span class="skill-total">{{sk.total}}</span>
                <span class="skill-custom-actions">
                  <button type="button" class="skill-roll" title="Roll {{sk.name}}"><i class="fas fa-dice-d20"></i></button>
                  <a class="item-control item-edit" title="{{localize 'MF.Edit'}}" data-item-id="{{sk.id}}"><i class="fas fa-thumbtack"></i></a>
                  <a class="item-control custom-skill-delete" title="{{localize 'MF.Delete'}}" data-item-id="{{sk.id}}"><i class="fas fa-trash"></i></a>
                </span>
              </div>
            {{/each}}
          </div>
        </section>
      </div>
    </div>
  {{else}}
    <p class="mf-empty">{{localize 'MF.NoSkills'}}</p>
  {{/if}}
</div>
